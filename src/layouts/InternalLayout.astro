---
import BaseLayout from './BaseLayout.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  intro?: string;
  backHref?: string;
  backLabel?: string;
}

const {
  title,
  description,
  eyebrow = 'Internal',
  intro = description,
  backHref,
  backLabel = 'Back to Internal',
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL;
const withBase = (path = '') => `${baseUrl}${path}`.replace(/\/{2,}/g, '/');
---

<BaseLayout title={title} description={description} noIndex={true}>
  <section class="internal-hero section--hero bg-grid bg-radial">
    <div class="container internal-hero__container">
      {backHref && (
        <a href={withBase(backHref)} class="internal-back">{backLabel}</a>
      )}
      <span class="badge animate-fade-in-up">{eyebrow}</span>
      <h1 class="internal-hero__title animate-fade-in-up stagger-1">{title}</h1>
      <p class="internal-hero__subtitle animate-fade-in-up stagger-2">{intro}</p>
    </div>
  </section>

  <div class="internal-body">
    <slot />
  </div>
</BaseLayout>

<style>
  .internal-hero {
    position: relative;
    overflow: hidden;
  }

  .internal-hero__container {
    max-width: 880px;
  }

  .internal-back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: var(--space-lg);
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--bf-text-muted);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .internal-back::before {
    content: '←';
    color: var(--bf-red);
  }

  .internal-back:hover {
    color: var(--bf-text-primary);
  }

  .internal-hero__title {
    margin-top: var(--space-xl);
    margin-bottom: var(--space-lg);
    max-width: 13ch;
  }

  .internal-hero__subtitle {
    max-width: 760px;
    font-size: 1.08rem;
  }

  .internal-body {
    padding-bottom: var(--space-5xl);
  }

  :global(.internal-section) {
    padding: var(--space-3xl) 0;
  }

  :global(.internal-section + .internal-section) {
    border-top: 1px solid var(--bf-border);
  }

  :global(.internal-section__header) {
    max-width: 760px;
    margin-bottom: var(--space-2xl);
  }

  :global(.internal-section__eyebrow) {
    display: inline-flex;
    margin-bottom: var(--space-md);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--bf-red);
  }

  :global(.internal-grid) {
    display: grid;
    gap: var(--space-xl);
  }

  :global(.internal-grid--2) {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  :global(.internal-card) {
    background: var(--bf-surface);
    border: 1px solid var(--bf-border);
    border-radius: var(--radius-lg);
    padding: var(--space-2xl);
  }

  :global(.internal-card h3) {
    margin-bottom: var(--space-md);
  }

  :global(.internal-card p + p) {
    margin-top: var(--space-md);
  }

  :global(.internal-card__link) {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: var(--space-lg);
    color: var(--bf-text-primary);
    font-weight: 600;
    transition: color var(--duration-fast) var(--ease-out);
  }

  :global(.internal-card__link:hover) {
    color: var(--bf-red);
  }

  :global(.internal-list) {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
  }

  :global(.internal-list li) {
    position: relative;
    padding-left: 1.1rem;
    color: var(--bf-text-secondary);
    line-height: 1.7;
  }

  :global(.internal-list li::before) {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72rem;
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 50%;
    background: var(--bf-red);
  }

  :global(.internal-table) {
    width: 100%;
    border-collapse: collapse;
    background: var(--bf-surface);
    border: 1px solid var(--bf-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  :global(.internal-table th),
  :global(.internal-table td) {
    text-align: left;
    padding: 1rem 1.15rem;
    border-bottom: 1px solid var(--bf-border);
    vertical-align: top;
  }

  :global(.internal-table th) {
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--bf-text-primary);
    background: rgba(255, 255, 255, 0.02);
  }

  :global(.internal-table td) {
    color: var(--bf-text-secondary);
    line-height: 1.7;
  }

  :global(.internal-note) {
    padding: var(--space-lg) var(--space-xl);
    border-radius: var(--radius-lg);
    background: rgba(230, 57, 70, 0.08);
    border: 1px solid rgba(230, 57, 70, 0.18);
  }

  :global(.internal-note strong) {
    color: var(--bf-text-primary);
  }

  @media (max-width: 900px) {
    :global(.internal-grid--2) {
      grid-template-columns: 1fr;
    }

    :global(.internal-table) {
      display: block;
      overflow-x: auto;
    }
  }
</style>
