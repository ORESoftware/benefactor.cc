---
import BaseLayout from '../layouts/BaseLayout.astro';
import { quoteTiers } from '../data/quoteTiers';
import '../styles/global.css';
---

<BaseLayout
  title="Get a Quote"
  description="Choose a Benefactor service level and request a scoped quote for search, acquisition, conversion, automation, and growth delivery."
>
  <section class="quote-hero section--hero bg-grid bg-radial">
    <div class="container quote-hero__container">
      <span class="badge">Transparent service levels</span>
      <h1>Pick the delivery lane.<br /><span class="gradient-text">We’ll scope the work.</span></h1>
      <p>Five levels of delivery, from a one-week diagnostic to an embedded growth pod. Public prices are starting points; the final statement of work controls scope and price.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="tier-grid" aria-label="Benefactor service tiers">
        {quoteTiers.map((tier) => (
          <article class="tier-card">
            <div>
              <p class="tier-card__delivery">{tier.delivery}</p>
              <h2>{tier.name}</h2>
              <p class="tier-card__price"><strong>{tier.price}</strong> <span>{tier.cadence}</span></p>
              <p>{tier.description}</p>
            </div>
            <ul>{tier.includes.map((item) => <li>{item}</li>)}</ul>
            <a class="btn btn--secondary" href={`#quote-form?tier=${tier.id}`} data-tier-link={tier.id}>Request {tier.name}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section quote-form-section" id="quote-form">
    <div class="container quote-form-shell">
      <div>
        <span class="badge">Quote intake</span>
        <h2>Tell us what you need to move.</h2>
        <p>We’ll use this intake to prepare the first scope. You can submit without creating an account; signed-in customers can continue at <a href="https://app.benefactor.cc/quote">app.benefactor.cc/quote</a>.</p>
      </div>
      <form class="quote-form" data-quote-form data-api-origin="https://api.benefactor.cc">
        <input type="hidden" name="submission_id" />
        <label><span>Name</span><input name="name" autocomplete="name" maxlength="160" required /></label>
        <label><span>Work email</span><input type="email" name="email" autocomplete="email" maxlength="320" required /></label>
        <label><span>Company</span><input name="company" autocomplete="organization" maxlength="200" required /></label>
        <label><span>Website</span><input type="url" name="website" autocomplete="url" placeholder="https://example.com" /></label>
        <label>
          <span>Service level</span>
          <select name="tier" required>
            <option value="">Choose a tier</option>
            {quoteTiers.map((tier) => <option value={tier.id}>{tier.name} — {tier.price} {tier.cadence}</option>)}
          </select>
        </label>
        <label><span>What should improve in the next 90 days?</span><textarea name="goals" minlength="30" maxlength="4000" rows="6" required></textarea></label>
        <label><span>Current monthly marketing / acquisition spend (optional)</span><input name="current_monthly_spend" maxlength="100" placeholder="$5,000 / month" /></label>
        <label><span>Anything we should know about timing, systems, or constraints?</span><textarea name="constraints" maxlength="4000" rows="5"></textarea></label>
        <button class="btn btn--primary btn--large" type="submit">Request quote</button>
        <p class="quote-form__status" role="status" aria-live="polite" data-quote-status></p>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector('[data-quote-form]');
  const status = document.querySelector('[data-quote-status]');
  if (form instanceof HTMLFormElement) {
    const tierSelect = form.elements.namedItem('tier');
    const tierFromUrl = new URL(window.location.href).searchParams.get('tier');
    if (tierFromUrl && tierSelect instanceof HTMLSelectElement) tierSelect.value = tierFromUrl;
    for (const link of document.querySelectorAll('[data-tier-link]')) {
      link.addEventListener('click', () => {
        const tier = link.getAttribute('data-tier-link');
        if (tier && tierSelect instanceof HTMLSelectElement) tierSelect.value = tier;
      });
    }
    const submission = form.elements.namedItem('submission_id');
    if (submission instanceof HTMLInputElement) submission.value = crypto.randomUUID();
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      const button = form.querySelector('button[type="submit"]');
      if (button instanceof HTMLButtonElement) button.disabled = true;
      if (status) status.textContent = 'Submitting securely…';
      const data = new FormData(form);
      const payload = Object.fromEntries([...data.entries()].map(([key, value]) => [key, String(value).trim()]));
      try {
        const response = await fetch(`${form.dataset.apiOrigin}/v1/quote-requests`, {
          method: 'POST',
          mode: 'cors',
          credentials: 'omit',
          redirect: 'error',
          headers: {
            'content-type': 'application/json',
            'idempotency-key': `public-quote:${payload.submission_id}`,
          },
          body: JSON.stringify(payload),
        });
        if (!response.ok) throw new Error('quote request rejected');
        const receipt = await response.json();
        if (typeof receipt?.submission_id !== 'string') throw new Error('invalid receipt');
        if (status) status.textContent = `Received. Quote request ${receipt.submission_id} is in the queue.`;
        form.querySelectorAll('input, select, textarea, button').forEach((control) => { control.disabled = true; });
      } catch {
        if (status) status.textContent = 'We could not confirm the quote request. Please retry; the same submission ID is safe to reuse.';
        if (button instanceof HTMLButtonElement) button.disabled = false;
      }
    });
  }
</script>

<style>
  .quote-hero { text-align: center; }
  .quote-hero__container { max-width: 820px; }
  .quote-hero h1 { margin-top: var(--space-md); font-size: clamp(2.4rem, 6vw, 4.2rem); line-height: 1.02; }
  .quote-hero p { max-width: 720px; margin: var(--space-lg) auto 0; color: var(--bf-text-secondary); font-size: 1.08rem; line-height: 1.65; }
  .tier-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: var(--space-md); align-items: stretch; }
  .tier-card { display: flex; flex-direction: column; gap: var(--space-lg); justify-content: space-between; padding: var(--space-xl); border: 1px solid var(--bf-border); border-radius: var(--radius-lg); background: var(--bf-surface); }
  .tier-card h2 { margin-top: var(--space-xs); font-size: 1.35rem; }
  .tier-card__delivery { color: var(--bf-accent); font-size: .78rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .tier-card__price { margin: var(--space-sm) 0; }
  .tier-card__price strong { font-size: 1.7rem; }
  .tier-card__price span, .tier-card p, .tier-card li { color: var(--bf-text-secondary); }
  .tier-card ul { display: grid; gap: var(--space-sm); padding-left: 1.15rem; line-height: 1.45; }
  .quote-form-section { border-top: 1px solid var(--bf-border); }
  .quote-form-shell { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: var(--space-3xl); align-items: start; }
  .quote-form-shell h2 { margin: var(--space-md) 0; font-size: clamp(2rem, 4vw, 3rem); }
  .quote-form-shell p { color: var(--bf-text-secondary); line-height: 1.65; }
  .quote-form { display: grid; gap: var(--space-lg); padding: var(--space-2xl); border: 1px solid var(--bf-border); border-radius: var(--radius-lg); background: var(--bf-surface); }
  .quote-form label { display: grid; gap: var(--space-xs); font-weight: 600; }
  .quote-form input, .quote-form select, .quote-form textarea { width: 100%; box-sizing: border-box; border: 1px solid var(--bf-border); border-radius: var(--radius-sm); padding: .85rem 1rem; background: var(--bf-bg); color: var(--bf-text-primary); font: inherit; }
  .quote-form textarea { resize: vertical; }
  .quote-form__status { min-height: 1.5rem; margin: 0; }
  @media (max-width: 1180px) { .tier-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 760px) { .tier-grid, .quote-form-shell { grid-template-columns: 1fr; } }
</style>
