---
import BlogLayout from '../../layouts/BlogLayout.astro';
import '../../styles/global.css';
import { getBlogPostMeta } from '../../data/blogPosts';
import { getLocalSeoCaseStudy, localSeoCaseStudies } from '../../data/localSeoCaseStudies';

export function getStaticPaths() {
  return localSeoCaseStudies.map((caseStudy) => ({
    params: { slug: caseStudy.slug },
  }));
}

const { slug } = Astro.params;

if (!slug) {
  throw new Error('Missing blog slug');
}

const frontmatter = getBlogPostMeta(slug);
const caseStudy = getLocalSeoCaseStudy(slug);
---

<BlogLayout {...frontmatter}>
  <h2 id="why-this-happened">{caseStudy.whyHeading}</h2>
  <p>{caseStudy.story}</p>

  <h2>{caseStudy.stepsHeading}</h2>
  <ol>
    {caseStudy.steps.map((step) => <li>{step}</li>)}
  </ol>

  <h2 id="current-situation">What to measure</h2>
  <p>{caseStudy.measurement}</p>

  <div class="blog-cta">
    <h2 id="what-benefactor-does">How Benefactor helps {caseStudy.industryPlural}</h2>
    <p>{caseStudy.benefactorCopy}</p>
    <a href="mailto:hello@benefactor.cc" class="btn btn--primary btn--large">
      Ask about local search in your service area
    </a>
  </div>
</BlogLayout>
