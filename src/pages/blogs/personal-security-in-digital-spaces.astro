---
import BlogLayout from '../../layouts/BlogLayout.astro';
import '../../styles/global.css';
import { getBlogPostMeta } from '../../data/blogPosts';
import { Content } from '../../../assets/blogs/personal-security-in-digital-spaces.md';

const frontmatter = getBlogPostMeta('personal-security-in-digital-spaces');
---

<BlogLayout {...frontmatter}>
  <Content />
  <div class="blog-cta">
    <h3>Review your business’s public footprint</h3>
    <p>Benefactor can help your team spot outdated contact details and misleading listings that customers encounter in search.</p>
    <a href={import.meta.env.BASE_URL + 'contact/'} class="btn btn--primary btn--large" id="blog-cta-security-audit">
      Speak with Benefactor
    </a>
  </div>
</BlogLayout>
