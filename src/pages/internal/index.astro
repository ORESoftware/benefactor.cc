---
import InternalLayout from '../../layouts/InternalLayout.astro';
import { internalWorkspaceTabs } from '../../scripts/internal-tab-launcher';

const baseUrl = import.meta.env.BASE_URL;
const withBase = (path = '') => `${baseUrl}${path}`.replace(/\/{2,}/g, '/');
---

<InternalLayout
  title="Internal Affairs"
  description="Private working pages for Benefactor operations, commercial policy, client payment structures, and internal reference material."
  eyebrow="Private Index"
  intro="This is the internal index for private Benefactor operating notes. It is meant to hold working pages for retainers, payment mechanics, ad-spend handling, and other internal reference material that should not be surfaced in the public navigation."
>
  <section class="internal-section">
    <div class="container">
      <div class="internal-section__header">
        <span class="internal-section__eyebrow">Workspace Launcher</span>
        <h2>Open the Benefactor working set</h2>
        <p>
          Open the social, CRM, inbox, code, and AI tabs used for day-to-day Benefactor work.
          Successfully opened tabs are remembered so repeated clicks only target anything still missing.
        </p>
      </div>

      <article class="internal-card internal-launcher">
        <div class="internal-launcher__content">
          <div>
            <h3>Benefactor workspace</h3>
            <p>
              Instagram, Facebook, TikTok, LinkedIn, Gmail, HubSpot, GitHub, and ChatGPT.
            </p>
          </div>

          <div class="internal-launcher__actions">
            <button
              type="button"
              class="btn btn--primary internal-launcher__button"
              id="open-workspace-tabs"
              aria-describedby="workspace-launcher-note workspace-launcher-status"
            >
              Open all 8 tabs
            </button>
            <button
              type="button"
              class="btn internal-launcher__button internal-launcher__fallback"
              id="open-next-workspace-tab"
              aria-describedby="workspace-launcher-note workspace-launcher-status"
              hidden
            >
              Open next tab
            </button>
            <button
              type="button"
              class="internal-launcher__reset"
              id="forget-workspace-tabs"
            >
              Forget remembered tabs
            </button>
          </div>
        </div>

        <ul class="internal-launcher__services" aria-label="Benefactor workspace tabs">
          {internalWorkspaceTabs.map((destination) => (
            <li>
              <a
                href={destination.url}
                target="_blank"
                rel="noopener noreferrer"
                data-workspace-service-id={destination.id}
              >
                {destination.label}
                <span aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ul>

        <p class="internal-launcher__note" id="workspace-launcher-note">
          “Open all 8 tabs” always retries every missing service in one click. If your browser blocks multiple
          pop-ups, allow pop-ups for benefactor.cc and press the bulk button again. The separate “Open next tab”
          button is only a fallback for browsers that enforce one new tab per user gesture.
        </p>
        <p class="internal-launcher__status" id="workspace-launcher-status" role="status" aria-live="polite"></p>
      </article>
    </div>
  </section>

  <section class="internal-section">
    <div class="container">
      <div class="internal-section__header">
        <span class="internal-section__eyebrow">Current Pages</span>
        <h2>Private operating references</h2>
        <p>
          Start here when we need to reference how Benefactor structures commercial agreements,
          receives payment, or handles pass-through spend on behalf of clients.
        </p>
      </div>

      <div class="internal-grid internal-grid--2">
        <article class="internal-card">
          <h3>Retainer Model</h3>
          <p>
            The working view on monthly retainers, what gets billed in advance, how scope and
            approvals should be handled, and how agency fees stay separate from pass-through
            media spend.
          </p>
          <a href={withBase('internal/retainer/')} class="internal-card__link">
            Open retainer notes
            <span aria-hidden="true">→</span>
          </a>
        </article>

        <article class="internal-card">
          <h3>Payments and Ad Spend</h3>
          <p>
            Reference for how clients can pay Benefactor, how virtual cards or controlled
            budgets can be used, and how we should think about managing ad spend on behalf of
            clients without losing control or auditability.
          </p>
          <a href={withBase('internal/payments/')} class="internal-card__link">
            Open payment notes
            <span aria-hidden="true">→</span>
          </a>
        </article>
      </div>
    </div>
  </section>

  <section class="internal-section">
    <div class="container">
      <div class="internal-section__header">
        <span class="internal-section__eyebrow">Working Principles</span>
        <h2>Default internal stance</h2>
      </div>

      <div class="internal-grid internal-grid--2">
        <article class="internal-card">
          <h3>Commercial discipline</h3>
          <ul class="internal-list">
            <li>Agency fees and pass-through spend should be treated as separate budget lines.</li>
            <li>Any client-funded media or software spend should have a hard ceiling and explicit ownership.</li>
            <li>Anything likely to create reimbursement confusion should be documented before kickoff.</li>
          </ul>
        </article>

        <article class="internal-card">
          <h3>Operational preference</h3>
          <ul class="internal-list">
            <li>Client-owned ad accounts are preferred whenever practical.</li>
            <li>Client-issued virtual cards are preferred over shared physical prepaid cards.</li>
            <li>Approval thresholds and reporting cadence should be written into the commercial agreement.</li>
          </ul>
        </article>
      </div>
    </div>
  </section>
</InternalLayout>

<script>
  import {
    forgetInternalWorkspaceTabs,
    internalWorkspaceTabs,
    openInternalWorkspaceTabs,
    rememberInternalWorkspaceTab,
  } from '../../scripts/internal-tab-launcher';

  const openAllButton = document.querySelector<HTMLButtonElement>('#open-workspace-tabs');
  const openNextButton = document.querySelector<HTMLButtonElement>('#open-next-workspace-tab');
  const forgetButton = document.querySelector<HTMLButtonElement>('#forget-workspace-tabs');
  const status = document.querySelector<HTMLElement>('#workspace-launcher-status');
  const serviceLinks = document.querySelectorAll<HTMLAnchorElement>('[data-workspace-service-id]');
  const destinationsById = new Map(internalWorkspaceTabs.map((destination) => [destination.id, destination]));

  const setStatus = (message: string) => {
    if (status) status.textContent = message;
  };

  const destinationLabel = (id: string | null): string | null =>
    id ? destinationsById.get(id)?.label ?? null : null;

  const openedLabels = (ids: readonly string[]): string[] =>
    ids
      .map((id) => destinationLabel(id))
      .filter((label): label is string => Boolean(label));

  const updateButtons = (remaining: number, nextId: string | null, showFallback: boolean) => {
    if (openAllButton) {
      openAllButton.textContent = remaining === 0
        ? 'Workspace tabs ready'
        : remaining === internalWorkspaceTabs.length
          ? 'Open all 8 tabs'
          : `Open all remaining ${remaining} tabs`;
    }

    if (openNextButton) {
      const nextLabel = destinationLabel(nextId);
      openNextButton.hidden = !showFallback || remaining === 0;
      openNextButton.textContent = nextLabel
        ? `Open next tab · ${nextLabel} (${remaining} left)`
        : 'Open next tab';
    }
  };

  openAllButton?.addEventListener('click', () => {
    const result = openInternalWorkspaceTabs(internalWorkspaceTabs, 'all');
    const alreadyKnown = result.reused + result.remembered;
    const labels = openedLabels(result.openedIds);
    const nextLabel = destinationLabel(result.nextDestinationId);

    updateButtons(result.remaining, result.nextDestinationId, result.blocked > 0);

    if (result.remaining === 0) {
      setStatus(
        result.opened > 0
          ? `Workspace ready: opened ${labels.join(', ')}; ${alreadyKnown} already remembered.`
          : `Workspace ready: all ${internalWorkspaceTabs.length} tabs are already remembered as open.`,
      );
      return;
    }

    if (result.blocked > 0) {
      const openedNow = labels.length > 0 ? `Opened ${labels.join(', ')}. ` : '';
      setStatus(
        `${openedNow}Your browser blocked additional pop-ups; ${result.remaining} still missing. ` +
        `Allow pop-ups for benefactor.cc, then press “Open all remaining ${result.remaining} tabs” to retry them together. ` +
        `Or use the one-tab fallback${nextLabel ? ` starting with ${nextLabel}` : ''}.`,
      );
      return;
    }

    setStatus(
      `Workspace tabs: ${result.opened} opened, ${alreadyKnown} already remembered, ${result.remaining} remaining.`,
    );
  });

  openNextButton?.addEventListener('click', () => {
    const result = openInternalWorkspaceTabs(internalWorkspaceTabs, 'next');
    const labels = openedLabels(result.openedIds);
    const nextLabel = destinationLabel(result.nextDestinationId);

    updateButtons(result.remaining, result.nextDestinationId, true);

    if (result.remaining === 0) {
      setStatus(labels.length > 0 ? `Workspace ready: opened ${labels.join(', ')}.` : 'Workspace tabs ready.');
      return;
    }

    if (result.blocked > 0) {
      setStatus(
        `Your browser blocked ${nextLabel ?? 'the next workspace tab'}. Allow pop-ups for benefactor.cc, ` +
        `or use the individual service links above.`,
      );
      return;
    }

    setStatus(`${labels.length > 0 ? `Opened ${labels.join(', ')}. ` : ''}${result.remaining} left.${nextLabel ? ` Next: ${nextLabel}.` : ''}`);
  });

  forgetButton?.addEventListener('click', () => {
    forgetInternalWorkspaceTabs();
    updateButtons(internalWorkspaceTabs.length, internalWorkspaceTabs[0]?.id ?? null, false);
    setStatus('Forgot the saved workspace-tab state. The next bulk click will try all eight services again.');
  });

  serviceLinks.forEach((link) => {
    link.addEventListener('click', () => {
      const id = link.dataset.workspaceServiceId;
      if (id) rememberInternalWorkspaceTab(id);
    });
  });
</script>

<style>
  .internal-launcher {
    display: grid;
    gap: var(--space-xl);
  }

  .internal-launcher__content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xl);
  }

  .internal-launcher__content p {
    max-width: 680px;
  }

  .internal-launcher__actions {
    display: flex;
    flex: 0 0 auto;
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-sm);
  }

  .internal-launcher__button {
    white-space: nowrap;
  }

  .internal-launcher__fallback {
    border: 1px solid var(--bf-border-hover);
    background: transparent;
    color: var(--bf-text-primary);
  }

  .internal-launcher__fallback[hidden] {
    display: none;
  }

  .internal-launcher__reset {
    border: 0;
    background: transparent;
    color: var(--bf-text-muted);
    cursor: pointer;
    font: inherit;
    font-size: 0.78rem;
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .internal-launcher__reset:hover {
    color: var(--bf-text-primary);
  }

  .internal-launcher__services {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .internal-launcher__services li {
    margin: 0;
  }

  .internal-launcher__services a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 0.8rem;
    border: 1px solid var(--bf-border);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.025);
    color: var(--bf-text-secondary);
    font-size: 0.85rem;
    line-height: 1;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out),
      background var(--duration-fast) var(--ease-out);
  }

  .internal-launcher__services a:hover {
    border-color: var(--bf-border-hover);
    background: rgba(255, 255, 255, 0.05);
    color: var(--bf-text-primary);
  }

  .internal-launcher__note,
  .internal-launcher__status {
    margin: 0;
    color: var(--bf-text-muted);
    font-size: 0.88rem;
    line-height: 1.6;
  }

  .internal-launcher__status:not(:empty) {
    color: var(--bf-text-primary);
  }

  @media (max-width: 760px) {
    .internal-launcher__content {
      align-items: stretch;
      flex-direction: column;
    }

    .internal-launcher__actions,
    .internal-launcher__button {
      width: 100%;
    }
  }
</style>
