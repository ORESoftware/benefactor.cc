---
import BaseLayout from '../layouts/BaseLayout.astro';
import { teamMembers } from '../data/team';
import '../styles/global.css';

const baseUrl = import.meta.env.BASE_URL;
const withBase = (path = '') => `${baseUrl}${path}`.replace(/\/{2,}/g, '/');
---

<BaseLayout
  title="Team"
  description="Meet the Benefactor team — a distributed group of strategy, SEO, AEO, paid acquisition, design, PR, social, and business development specialists supporting founder-led B2B companies."
>
  <section class="team-hero section--hero bg-grid bg-radial">
    <div class="container team-hero__container">
      <span class="badge animate-fade-in-up">Our people</span>
      <h1 class="team-hero__title animate-fade-in-up stagger-1">
        A distributed team built to <span class="gradient-text">ship and scale</span>
      </h1>
      <p class="team-hero__subtitle animate-fade-in-up stagger-2">
        Strategy, SEO, AEO, paid acquisition, design, PR, social visibility, and business
        development under one roof — working alongside founder-led B2B teams.
      </p>
    </div>
  </section>

  <section class="team section">
    <div class="container">
      <div class="team__grid">
        {teamMembers.map((member) => (
          <article class="team__member animate-fade-in-up" id={`team-${member.id}`}>
            <div class="team__photo-wrap">
              <img src={withBase(member.image.slice(1))} alt={member.name} class="team__photo" loading="lazy" />
            </div>
            <h2 class="team__name">{member.name}</h2>
            <p class="team__title">
              <span class="team__role">{member.role}</span>
              <span class="team__specialty">{member.specialty}</span>
            </p>
            <p class="team__location">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              {member.location}
            </p>
            {member.profileUrl && (
              <a href={member.profileUrl} class="team__profile" target="_blank" rel="noreferrer">
                LinkedIn
              </a>
            )}
          </article>
        ))}
      </div>

      <div class="team__cta">
        <a href={withBase('#contact')} class="btn btn--primary">Work with us</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .team-hero {
    text-align: center;
  }

  .team-hero__container {
    max-width: 820px;
  }

  .team-hero__title {
    margin-top: var(--space-md);
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    line-height: 1.05;
  }

  .team-hero__subtitle {
    max-width: 680px;
    margin: var(--space-lg) auto 0;
    color: var(--bf-text-secondary);
    font-size: 1.1rem;
    line-height: 1.6;
  }

  .team__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-md);
  }

  .team__member {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--space-2xl) var(--space-lg);
    background: var(--bf-surface);
    border: 1px solid var(--bf-border);
    border-radius: var(--radius-lg);
    transition: all var(--duration-normal) var(--ease-out);
  }

  .team__member:hover {
    border-color: var(--bf-border-active);
    transform: translateY(-4px);
    box-shadow: var(--shadow-glow);
  }

  .team__member:hover .team__photo {
    filter: grayscale(0%);
  }

  .team__photo-wrap {
    width: 180px;
    height: 180px;
    border-radius: 50%;
    overflow: hidden;
    margin-bottom: var(--space-lg);
    border: 3px solid var(--bf-border);
    transition: border-color var(--duration-normal) var(--ease-out);
  }

  .team__member:hover .team__photo-wrap {
    border-color: var(--bf-red);
  }

  .team__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    filter: grayscale(100%);
    transition: filter var(--duration-normal) var(--ease-out);
  }

  .team__name {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--bf-text-primary);
    margin-bottom: 0.25rem;
  }

  .team__title {
    display: flex;
    min-height: 2.75rem;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 0.25rem;
    margin-bottom: var(--space-sm);
    line-height: 1.25;
  }

  .team__role {
    color: var(--bf-red);
    font-size: 0.84rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .team__specialty {
    max-width: 18ch;
    color: var(--bf-text-secondary);
    font-size: 0.88rem;
    font-weight: 600;
  }

  .team__location {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.78rem;
    color: var(--bf-text-muted);
    font-weight: 500;
  }

  .team__location svg {
    opacity: 0.5;
  }

  .team__profile {
    margin-top: var(--space-md);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.45rem 0.9rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--bf-border-hover);
    color: var(--bf-text-primary);
    font-size: 0.78rem;
    font-weight: 600;
    transition: all var(--duration-fast) var(--ease-out);
  }

  .team__profile:hover {
    border-color: var(--bf-red);
    color: var(--bf-red);
    background: var(--bf-red-glow);
  }

  .team__cta {
    margin-top: var(--space-2xl);
    text-align: center;
  }

  @media (max-width: 768px) {
    .team__grid {
      grid-template-columns: 1fr;
    }

    .team__photo-wrap {
      width: 140px;
      height: 140px;
    }
  }
</style>
