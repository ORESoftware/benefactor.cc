---
import BaseLayout from '../layouts/BaseLayout.astro';
import { teamMembers } from '../data/team';
import '../styles/global.css';

const stats = [
  { number: '90-180', label: 'Day engagements' },
  { number: '2-20', label: 'Person teams' },
  { number: 'B2B', label: 'SaaS and services' },
  { number: 'SEO/SEM', label: 'Plus automation' },
];

const fitPills = [
  'Founder-led B2B teams',
  '90-180 day engagements',
  '2-20 person teams',
  'Search, paid, and automation',
];

const focusAreas = [
  {
    title: 'Search strategy built around buyer intent',
    description:
      'We rebuild SEO around the way founders, operators, and revenue leaders actually search when they are diagnosing a problem or evaluating options.',
    features: [
      'High-intent keyword mapping',
      'Pillar-cluster site architecture',
      'Decision-stage landing pages',
      'Content tied to pipeline influence',
    ],
  },
  {
    title: 'Paid search aligned to real jobs-to-be-done',
    description:
      'We tighten campaigns around problem-aware queries, match pages to specific use cases, and remove the gaps between keyword, promise, and activation.',
    features: [
      'Search campaign restructuring',
      'Message-to-page alignment',
      'Offer testing by intent',
      'Lower cost per qualified action',
    ],
  },
  {
    title: 'Automation that replaces manual follow-up',
    description:
      'We connect forms, CRM stages, email, and calendars so qualified leads move to the next step without founders living inside a dozen tools.',
    features: [
      'Behavior-based nurture sequences',
      'Lead routing and lifecycle stages',
      'Calendar and follow-up automation',
      'CRM as a single source of truth',
    ],
  },
  {
    title: 'Measurement that shows what moved revenue',
    description:
      'We build reporting founders can actually use: where demand came from, which pages influenced deals, and where the funnel is leaking.',
    features: [
      'Closed-won content attribution',
      'Source-of-truth dashboards',
      'Funnel leak analysis',
      'Weekly decision-ready reporting',
    ],
  },
];

const coreCompetencies = [
  {
    title: 'Growth hacking',
    highlight: 'Fast feedback loops',
    description:
      'We run disciplined experiments across offers, creatives, landing pages, and channel mix so growth decisions come from real conversion data instead of guesswork.',
    capabilities: [
      'Acquisition experiments tied to qualified actions',
      'Rapid landing page and offer iteration',
      'Creative testing across search and paid social',
      'Funnel-level learning shared back into messaging',
    ],
  },
  {
    title: 'Software scaling and automation',
    highlight: 'Operational leverage',
    description:
      'We connect the demand engine to the operating system underneath it so leads, handoffs, reporting, and follow-up scale without adding manual busywork to the team.',
    capabilities: [
      'CRM and lifecycle workflow design',
      'Lead routing, scoring, and follow-up logic',
      'Reporting pipelines founders can actually trust',
      'Automated handoffs between marketing, sales, and ops',
    ],
  },
];

const processSteps = [
  {
    number: '01',
    title: 'Diagnose the highest-intent opportunity',
    description:
      'We audit acquisition channels, search behavior, and follow-up gaps to find the pages, keywords, and handoffs most likely to unlock pipeline first.',
  },
  {
    number: '02',
    title: 'Prioritize the funnel around buying intent',
    description:
      'We simplify the roadmap so traffic sources, offers, landing pages, and CRM stages all support the same conversion path instead of competing with each other.',
  },
  {
    number: '03',
    title: 'Ship pages, campaigns, and automation in sprints',
    description:
      'Each sprint turns into something live: tighter targeting, clearer messaging, better routing, cleaner attribution, or a stronger onboarding path.',
  },
  {
    number: '04',
    title: 'Measure pipeline and compound the wins',
    description:
      'We track the work against qualified conversations, activated accounts, and revenue influence so the system gets sharper every month.',
  },
];

const workStreams = [
  {
    name: 'Search intent architecture',
    meta: 'SEO · Service pages · Content systems',
    pill: 'Owned Demand',
    metrics: ['Keyword-to-page mapping', 'Decision-stage content'],
    challenge:
      'Founder-led teams often have useful expertise spread across thin pages, scattered posts, and campaigns that do not match how buyers search when they are ready to act.',
    built:
      'We map high-intent queries to service pages, comparison content, local pages, and supporting articles so each search has a clear destination and next step.',
    result:
      'The site becomes easier to crawl, easier for buyers to understand, and easier for the team to connect to qualified conversations.',
  },
  {
    name: 'Paid search alignment',
    meta: 'SEM · Landing pages · Offer testing',
    pill: 'Efficient Acquisition',
    metrics: ['Intent-led campaigns', 'Landing-page fit'],
    challenge:
      'Paid search gets expensive when campaigns point broad queries at generic pages and leave the sales promise disconnected from the buyer\'s problem.',
    built:
      'We group campaigns by job-to-be-done, tighten ad-to-page message match, and test offers against the actions the business actually wants.',
    result:
      'Budgets move toward clearer intent, better-qualified clicks, and landing pages that make the next action obvious.',
  },
  {
    name: 'Lifecycle automation',
    meta: 'CRM · Email · Follow-up workflows',
    pill: 'Revenue Operations',
    metrics: ['Behavior-based nurture', 'Clean handoffs'],
    challenge:
      'Many teams collect leads faster than they can route, qualify, and follow up, which turns good traffic into slow replies and lost context.',
    built:
      'We connect forms, CRM stages, email, calendars, and routing rules so qualified prospects get the right next step without manual chasing.',
    result:
      'Follow-up becomes faster, reporting becomes cleaner, and founders spend less time stitching together the funnel by hand.',
  },
  {
    name: 'Measurement and review loops',
    meta: 'Dashboards · Attribution · Weekly decisions',
    pill: 'Operating Rhythm',
    metrics: ['Pipeline-facing reporting', 'Funnel leak review'],
    challenge:
      'Traffic reports are not enough when the business needs to know which pages, campaigns, and handoffs actually support revenue.',
    built:
      'We build reporting around calls, forms, booked meetings, pipeline movement, content influence, and the operational gaps that need attention.',
    result:
      'The team gets a practical weekly view of what changed, what is stuck, and what should ship next.',
  },
];

const operatingStandards = [
  {
    quote:
      'We separate strategy from guesswork by tying each recommendation to search intent, buyer behavior, conversion friction, or operational follow-up.',
    name: 'Evidence before scale',
    role: 'Research, analytics, and funnel diagnosis before larger channel bets',
    tag: 'Discovery',
  },
  {
    quote:
      'We prefer shipping small, measurable improvements quickly: cleaner pages, tighter campaigns, sharper forms, better routing, and clearer reporting.',
    name: 'Useful work every sprint',
    role: 'Execution that a founder-led team can inspect and keep using',
    tag: 'Delivery',
  },
  {
    quote:
      'We make handoffs explicit so marketing, sales, and operations can see who owns the next step and which signals should trigger follow-up.',
    name: 'Operational clarity',
    role: 'CRM, lifecycle, and reporting structures built for repeated use',
    tag: 'Systems',
  },
  {
    quote:
      'We report on decisions, not theater: what moved, what did not, what evidence changed, and what the next practical action should be.',
    name: 'Decision-ready reporting',
    role: 'Weekly signal review focused on pipeline and conversion movement',
    tag: 'Measurement',
  },
];

const baseUrl = import.meta.env.BASE_URL;
const withBase = (path = '') => `${baseUrl}${path}`.replace(/\/{2,}/g, '/');
---

<BaseLayout
  title="Benefactor - Search, Paid, and Automation for Founder-Led B2B"
  description="Benefactor partners with founder-led B2B teams to build search, paid, and automation systems that turn scattered traffic into a reliable pipeline of sales conversations."
>
  <section class="hero section--hero bg-grid bg-radial" id="hero">
    <div class="container">
      <div class="hero__content">
        <div class="badge animate-fade-in-up">
          <span class="badge__dot"></span>
          Search, paid, and automation systems
        </div>

        <h1 class="hero__title animate-fade-in-up stagger-1">
          Leaner funnels.<br />
          <span class="gradient-text">Sharper intent. Compounding growth.</span>
        </h1>

        <p class="hero__subtitle animate-fade-in-up stagger-2">
          Benefactor partners with founder-led B2B teams to build search, paid, and automation
          systems that turn scattered traffic into a reliable pipeline of sales conversations.
        </p>

        <div class="hero__actions animate-fade-in-up stagger-3">
          <a href="https://calendly.com/hello-benefactor/30min" target="_blank" rel="noopener" class="btn btn--primary btn--large" id="hero-cta-primary">
            Book a Strategy Call
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path
                d="M3 8h10M9 4l4 4-4 4"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>
            </svg>
          </a>
          <a href="#results" class="btn btn--secondary btn--large" id="hero-cta-secondary">
            See Workstreams
          </a>
        </div>

        <div class="hero__capabilities animate-fade-in-up stagger-4">
          <span class="hero__capabilities-label">Typical fit</span>
          <div class="hero__capability-badges">
            {fitPills.map((pill) => <span class="hero__capability-badge">{pill}</span>)}
          </div>
        </div>
      </div>
    </div>

    <div class="hero__orb" aria-hidden="true"></div>
    <div class="hero__orb hero__orb--2" aria-hidden="true"></div>
  </section>

  <section class="stats" id="stats-bar">
    <div class="container">
      <div class="stats__grid">
        {stats.map((stat) => (
          <div class="stats__item animate-fade-in-up">
            <span class="stats__number">{stat.number}</span>
            <span class="stats__label">{stat.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="services section" id="services">
    <div class="container">
      <div class="services__header">
        <span class="badge animate-fade-in-up">What we build</span>
        <h2 class="animate-fade-in-up stagger-1">
          Growth systems that turn intent into <span class="gradient-text">pipeline</span>
        </h2>
        <p class="services__desc animate-fade-in-up stagger-2">
          Search, paid, and automation only work when the handoffs between them are tight. We
          build the pages, campaigns, follow-up, and measurement layers as one system.
        </p>
      </div>

      <div class="services__grid">
        {focusAreas.map((area, index) => (
          <div class="card services__card animate-fade-in-up">
            <div class="services__kicker">{String(index + 1).padStart(2, '0')}</div>
            <h3>{area.title}</h3>
            <p>{area.description}</p>
            <ul class="services__features">
              {area.features.map((feature) => <li>{feature}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="competencies section bg-noise" id="competencies">
    <div class="container competencies__container">
      <div class="competencies__header">
        <span class="badge animate-fade-in-up">Core competencies</span>
        <h2 class="animate-fade-in-up stagger-1">
          Where strategy meets <span class="gradient-text">execution leverage</span>
        </h2>
        <p class="competencies__desc animate-fade-in-up stagger-2">
          Beyond search and paid, we build the experimentation muscle and operational
          infrastructure that help small teams scale faster without losing signal.
        </p>
      </div>

      <div class="competencies__rows">
        {coreCompetencies.map((competency, index) => (
          <article class="card competencies__row animate-fade-in-up">
            <div class="competencies__index">{String(index + 1).padStart(2, '0')}</div>
            <div class="competencies__body">
              <div class="competencies__top">
                <div>
                  <span class="competencies__eyebrow">{competency.highlight}</span>
                  <h3>{competency.title}</h3>
                </div>
                <div class="competencies__divider" aria-hidden="true"></div>
              </div>
              <p>{competency.description}</p>
              <ul class="competencies__list">
                {competency.capabilities.map((capability) => <li>{capability}</li>)}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="process section bg-noise" id="process">
    <div class="container process__container">
      <div class="process__header">
        <span class="badge animate-fade-in-up">How we work</span>
        <h2 class="animate-fade-in-up stagger-1">
          Fast enough to create momentum, structured enough to <span class="gradient-text">compound</span>
        </h2>
      </div>

      <div class="process__timeline">
        {processSteps.map((step) => (
          <div class="process__step animate-fade-in-up">
            <div class="process__step-number">{step.number}</div>
            <div class="process__step-content">
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="portfolio section" id="results" aria-labelledby="portfolio-heading">
    <div class="container">
      <div class="portfolio__header">
        <span class="badge animate-fade-in-up">What becomes real</span>
        <h2 id="portfolio-heading" class="animate-fade-in-up stagger-1">
          Four workstreams that move from idea to operating system
        </h2>
        <p class="portfolio__desc animate-fade-in-up stagger-2">
          No invented client logos, no pretend testimonials. These are the concrete systems
          Benefactor builds for founder-led teams that need demand generation to connect with
          follow-up and measurement.
        </p>
      </div>

      <div class="portfolio__grid">
        {workStreams.map((story) => (
          <article class="card portfolio__card animate-fade-in-up">
            <div class="portfolio__top">
              <div>
                <h3 class="portfolio__name">{story.name}</h3>
                <p class="portfolio__meta">{story.meta}</p>
              </div>
              <span class="portfolio__pill">{story.pill}</span>
            </div>

            <div class="portfolio__metrics">
              {story.metrics.map((metric) => <span class="portfolio__metric">{metric}</span>)}
            </div>

            <div class="portfolio__block">
              <span class="portfolio__label">Challenge</span>
              <p class="portfolio__copy">{story.challenge}</p>
            </div>

            <div class="portfolio__block">
              <span class="portfolio__label">What we built</span>
              <p class="portfolio__copy">{story.built}</p>
            </div>

            <div class="portfolio__block">
              <span class="portfolio__label">Result</span>
              <p class="portfolio__copy">{story.result}</p>
            </div>
          </article>
        ))}
      </div>

      <p class="portfolio__note">
        This section describes live service workstreams. Public client proof should only be
        added here when the source, permission, and numbers are ready to publish.
      </p>
    </div>
  </section>

  <section class="team section" id="team" aria-labelledby="team-heading">
    <div class="container">
      <div class="team__header">
        <span class="badge animate-fade-in-up">Our people</span>
        <h2 id="team-heading" class="animate-fade-in-up stagger-1">
          A distributed team built to <span class="gradient-text">ship and scale</span>
        </h2>
        <p class="team__desc animate-fade-in-up stagger-2">
          Strategy, SEO, AEO, paid acquisition, design, PR, social visibility, and business
          development under one roof.
        </p>
      </div>

      <div class="team__grid">
        {teamMembers.map((member, index) => (
          <article class="team__member animate-fade-in-up" id={`team-${member.id}`}>
            <div class="team__photo-wrap">
              <img src={withBase(member.image.slice(1))} alt={member.name} class="team__photo" loading="lazy" />
            </div>
            <h3 class="team__name">{member.name}</h3>
            <p class="team__title">
              <span class="team__role">{member.role}</span>
              <span class="team__specialty">{member.specialty}</span>
            </p>
            <p class="team__location">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              {member.location}
            </p>
            {member.profileUrl && (
              <a href={member.profileUrl} class="team__profile" target="_blank" rel="noreferrer">
                LinkedIn
              </a>
            )}
          </article>
        ))}
      </div>

      <div class="team__cta">
        <a href={withBase('team/')} class="btn btn--secondary" id="team-page-link">Meet the full team</a>
      </div>
    </div>
  </section>

  <section class="voices section" id="partners" aria-labelledby="voices-heading">
    <div class="container">
      <div class="voices__header">
        <span class="badge animate-fade-in-up">Operating standards</span>
        <h2 id="voices-heading" class="animate-fade-in-up stagger-1">
          How we keep growth work grounded in real evidence
        </h2>
        <p class="voices__desc animate-fade-in-up stagger-2">
          These are internal commitments that define what clients should expect before any
          public testimonial is added.
        </p>
      </div>

      <div class="voices__grid">
        {operatingStandards.map((testimonial) => (
          <figure class="card voices__card animate-fade-in-up">
            <blockquote class="voices__quote">{testimonial.quote}</blockquote>
            <figcaption class="voices__author">
              <div>
                <p class="voices__name">{testimonial.name}</p>
                <p class="voices__role">{testimonial.role}</p>
              </div>
              <span class="voices__tag">{testimonial.tag}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="cta section bg-radial-navy" id="contact">
    <div class="container">
      <div class="cta__content animate-fade-in-up">
        <h2>
          Ready to turn scattered traffic into a <span class="gradient-text">reliable pipeline</span>?
        </h2>
        <p>
          Whether you need tighter search intent, cleaner paid acquisition, or automation that
          actually reduces founder workload, we will build a plan around the bottleneck that
          matters most.
        </p>
        <div class="cta__actions">
          <a href="https://calendly.com/hello-benefactor/30min" target="_blank" rel="noopener" class="btn btn--primary btn--large" id="cta-contact-btn">
            Schedule a Strategy Call
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path
                d="M3 8h10M9 4l4 4-4 4"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>
            </svg>
          </a>
          <a href="#results" class="btn btn--secondary btn--large" id="cta-services-btn">
            Review Workstreams
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    min-height: 90vh;
    display: flex;
    align-items: center;
  }

  .hero__content {
    max-width: 820px;
  }

  .hero__title {
    margin-top: var(--space-xl);
    margin-bottom: var(--space-lg);
  }

  .hero__subtitle {
    font-size: 1.2rem;
    max-width: 680px;
    margin-bottom: var(--space-2xl);
  }

  .hero__actions {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
    margin-bottom: var(--space-3xl);
  }

  .badge__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--bf-success);
    display: inline-block;
    animation: pulseGlow 2s ease-in-out infinite;
  }

  .hero__capabilities-label {
    font-size: 0.8rem;
    color: var(--bf-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 500;
    display: block;
    margin-bottom: var(--space-sm);
  }

  .hero__capability-badges {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .hero__capability-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--bf-text-secondary);
    background: var(--bf-surface);
    border: 1px solid var(--bf-border);
    border-radius: var(--radius-full);
    transition: all var(--duration-normal) var(--ease-out);
  }

  .hero__capability-badge:hover {
    border-color: var(--bf-border-active);
    color: var(--bf-red);
  }

  .hero__orb {
    position: absolute;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(230, 57, 70, 0.05), transparent 70%);
    top: -15%;
    right: -15%;
    animation: float 8s ease-in-out infinite;
    pointer-events: none;
  }

  .hero__orb--2 {
    width: 350px;
    height: 350px;
    background: radial-gradient(circle, rgba(30, 58, 95, 0.08), transparent 70%);
    bottom: 10%;
    right: 20%;
    top: auto;
    animation-delay: -4s;
  }

  .stats {
    padding: var(--space-3xl) 0;
    border-top: 1px solid var(--bf-border);
    border-bottom: 1px solid var(--bf-border);
    background: var(--bf-surface);
  }

  .stats__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-xl);
    text-align: center;
  }

  .stats__number {
    font-size: clamp(1.9rem, 3vw, 2.5rem);
    font-weight: 800;
    background: linear-gradient(135deg, var(--bf-red-light), var(--bf-red));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    display: block;
  }

  .stats__label {
    font-size: 0.85rem;
    color: var(--bf-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 500;
    margin-top: var(--space-xs);
    display: block;
  }

  .services__header,
  .process__header,
  .portfolio__header,
  .voices__header {
    text-align: center;
    margin-bottom: var(--space-3xl);
  }

  .services__header h2,
  .process__header h2,
  .portfolio__header h2,
  .voices__header h2 {
    margin-top: var(--space-md);
  }

  .services__desc,
  .portfolio__desc,
  .voices__desc {
    max-width: 720px;
    margin: var(--space-md) auto 0;
  }

  .services__grid,
  .portfolio__grid,
  .voices__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-xl);
  }

  .competencies__container {
    position: relative;
    z-index: 1;
  }

  .competencies__header,
  .team__header {
    text-align: center;
    margin-bottom: var(--space-3xl);
  }

  .competencies__header h2,
  .team__header h2 {
    margin-top: var(--space-md);
  }

  .competencies__desc,
  .team__desc {
    max-width: 720px;
    margin: var(--space-md) auto 0;
  }

  .competencies__rows {
    display: grid;
    gap: var(--space-xl);
  }

  .competencies__row {
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr);
    gap: var(--space-xl);
    align-items: flex-start;
  }

  .competencies__index {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 88px;
    height: 88px;
    border-radius: 50%;
    background: linear-gradient(135deg, rgba(230, 57, 70, 0.16), rgba(30, 58, 95, 0.16));
    border: 1px solid rgba(230, 57, 70, 0.2);
    color: var(--bf-text-primary);
    font-family: var(--font-mono);
    font-size: 1.15rem;
    font-weight: 700;
  }

  .competencies__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .competencies__top {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-lg);
  }

  .competencies__top h3 {
    margin-top: var(--space-xs);
  }

  .competencies__eyebrow {
    font-size: 0.72rem;
